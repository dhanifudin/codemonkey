# Supabase project shared with sibling apps (lulu, bomi). This app's client
# always targets the "codemonkey" schema (see src/lib/supabase/client.ts) so
# it can share a project without ever touching their data.
PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
PUBLIC_SUPABASE_ANON_KEY=your-anon-or-publishable-key
